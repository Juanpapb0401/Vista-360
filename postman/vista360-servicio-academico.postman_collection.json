          ]
        },
        {
          "name": "Evaluaciones de MAT2201 (una sola)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEstudiante}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/estudiantes/{{codigoEstudiante}}/materias/MAT2201/evaluaciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "estudiantes",
                "{{codigoEstudiante}}",
                "materias",
                "MAT2201",
                "evaluaciones"
              ]
