            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEstudiante}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/estudiantes/{{codigoEstudiante}}/materias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "estudiantes",
                "{{codigoEstudiante}}",
                "materias"
              ]
            },
            "description": "La nota ya esta poblada. El recalculo ocurrio al escribir, no en esta lectura."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const mat = pm.response.json().materias.content.find(m => m.codigoMateria === \"MAT2201\");",
                  "pm.test(\"MAT2201 ahora tiene nota 3.90\", () => pm.expect(Number(mat.notaActual)).to.eql(3.9));"
                ]
