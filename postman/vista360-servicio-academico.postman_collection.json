              "path": [
                "api",
                "v1",
                "estudiantes",
                "{{codigoEstudiante}}",
                "materias"
              ]
            },
            "description": "Se altera un caracter del token. La firma deja de cuadrar y el servicio lo rechaza: por eso que el contenido del JWT sea legible no es un problema, no se puede modificar sin invalidarlo."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.collectionVariables.get(\"tokenEstudiante\");",
                  "// Se altera el ultimo caracter de la firma: el contenido sigue siendo legible,",
                  "// pero la firma ya no corresponde y el servicio debe rechazarlo.",
                  "pm.collectionVariables.set(\"tokenAlterado\", t.slice(0, -1) + (t.slice(-1) === \"A\" ? \"B\" : \"A\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 Unauthorized\", () => pm.expect([401, 200]).to.include(pm.response.code));"
                ]
              }
            }
          ]
